{
  "name": "bb/content-pull",
  "description": "Pull the content folder of a source environment (usually production) into a development or staging environment — granular by scope, page and language.",
  "type": "kirby-plugin",
  "version": "1.4.2",
  "license": "MIT",
  "authors": [
    {
      "name": "Bold and Bright GmbH",
      "homepage": "https://boldbright.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "getkirby/composer-installer": "^1.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "BB\\ContentPull\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BB\\ContentPull\\Tests\\": "tests/"
    }
  },
  "extra": {
    "installer-name": "bb-content-pull"
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  }
}
